# ============ 应用 ============
APP_NAME=数学教材智能答疑助手
APP_VERSION=2.0.0
DEBUG=true
ENVIRONMENT=development
SECRET_KEY=change-me-in-production

# ============ 数据库 ============
DATABASE_URL=sqlite+aiosqlite:///./math_qa.db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# ============ Redis ============
REDIS_URL=redis://localhost:6379/0

# ============ JWT ============
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============ DeepSeek 大模型 ============
# 必填：DeepSeek 开放平台 API Key（https://platform.deepseek.com）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_CHAT_MODEL=deepseek-v4-pro
DEEPSEEK_REASONER_MODEL=deepseek-v4-pro

# ============ 联网搜索（可选）============
# 百度智能云 API Key；留空则回退到 Bing 网页抓取
BAIDU_SEARCH_API_KEY=

# ============ 视觉模型 VLM（可选）============
VLM_MODEL=
VLM_BASE_URL=

# ============ 内网穿透 natapp（可选）============
NATAPP_AUTHTOKEN=
NATAPP_BIN=

# ============ 设备 / 离线 ============
CUDA_DEVICE=cuda:0
# 无 GPU 时改为 cpu
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0

# ============ MinerU 文件解析（可选）============
MINERU_MODE=high-quality
MINERU_API_URL=
MINERU_BIN=
MINERU_API_BIN=

# ============ CORS ============
CORS_ORIGINS=["http://localhost:5173","http://localhost:5175","http://localhost:8000","http://localhost:3000"]
